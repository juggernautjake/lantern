# ===========================================================================
# lantern/server/.env.example — copy to .env and fill in.
# Real environment variables always win over this file, so a container's
# settings are never overridden by a copy somebody left on disk.
# ===========================================================================

# --- the only thing you have to supply ------------------------------------
# Everything AI-backed needs this and nothing else: chat, web search, image
# fetching, the written half of code review, rubric assessment.
# Without it the platform still runs: the filing system, permissions, search,
# the auto-grader and the deterministic code reviewer are all local.
ANTHROPIC_API_KEY=

# --- models, per job ------------------------------------------------------
# Chat and review want judgement; the quick model is for cheap classification.
LANTERN_MODEL_CHAT=claude-sonnet-5
LANTERN_MODEL_REVIEW=claude-sonnet-5
LANTERN_MODEL_GRADE=claude-sonnet-5
LANTERN_MODEL_QUICK=claude-haiku-4-5-20251001

# --- web search -----------------------------------------------------------
# The assistant searches the web through Anthropic's server-side tool, which
# returns cited sources. Searches are billed per search on top of tokens.
# LANTERN_WEB_SEARCH_VERSION=web_search_20250305
# LANTERN_WEB_MAX_USES=5
#
# Domains. By default the assistant is restricted to a short allow-list that
# suits this course. Set LANTERN_WEB_ALLOW to your own comma-separated list,
# or to an empty value to allow the open web and use the block list instead.
# LANTERN_WEB_ALLOW=adobe.com,developer.mozilla.org,wikipedia.org
# LANTERN_WEB_BLOCK=
#
# Localises results. Only used when set.
# LANTERN_USER_REGION=California
# LANTERN_USER_TZ=America/Chicago

# --- prompt caching -------------------------------------------------------
# The system prompt and the tool definitions are identical on every turn, so a
# cache breakpoint is put on them: a read costs about a tenth of a fresh write.
# A class of thirty asking the same assistant on the same afternoon is exactly
# the pattern this pays for. Set to "off" to disable, or "1h" for the longer
# time-to-live (which costs more to write and lasts an hour).
# LANTERN_PROMPT_CACHE=on
# LANTERN_CACHE_TTL=5m

# --- text extraction ------------------------------------------------------
# Uploaded files have their words pulled out and indexed, so a rubric nobody
# titled properly is still findable by what is in it. DOCX/XLSX/PPTX and PDF
# are read without a dependency; anything larger than this is skipped.
# LANTERN_MAX_EXTRACT=12582912

# --- spending -------------------------------------------------------------
# Per person, per month. When the ceiling is reached the hint ladder, the
# auto-grader and the code reviewer all keep working — none of them use the
# model — so running out degrades the experience rather than stopping it.
LANTERN_CAP_CALLS=500
LANTERN_CAP_SEARCHES=100
LANTERN_MAX_TOKENS=4096
LANTERN_AGENT_ROUNDS=8
LANTERN_AI_TIMEOUT=120000

# --- signing in ------------------------------------------------------------
# Solo mode: skip the sign-in screen entirely and treat every visitor as one
# named person. This is for your own machine. It is refused when NODE_ENV is
# production, and the boot banner says loudly when it is on.
#   LANTERN_SOLO=on                    the first student account
#   LANTERN_SOLO=sam@example.school  that specific person
# LANTERN_SOLO=on

# --- where things live ----------------------------------------------------
PORT=4321
# LANTERN_DB=server/data/lantern.db
# LANTERN_BLOBS=server/data/blobs
# LANTERN_APP_DIR=../app/cfml
LANTERN_SESSION_DAYS=14
LANTERN_MAX_UPLOAD=52428800
LANTERN_MAX_IMAGE=8388608

# --- storage: local disk by default --------------------------------------
# Set S3_BUCKET to move blobs to any S3-compatible store. The signature is
# written out in files/store.js, so there is still no dependency to install.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=blobs/
